{
  "extends": "../tsconfig.base.json",
  "include": ["test"],
  // `test/typetests` is tstyche's, and its negative cases (`expect().type.not.toBe`, a deliberately
  // misspelled circuit name) are *meant* to be type errors — tsc would read them as failures. It
  // is the only permanent exclusion; `test/era8` type-checks here like everything else, against
  // the hand-written fixture type in `test/era8/counterFixture.ts`.
  "exclude": ["test/typetests"],
  "references": [
    { "path": "tsconfig.src.json" },
  ],
  "compilerOptions": {
    "tsBuildInfoFile": ".tsbuildinfo/test.tsbuildinfo",
    "rootDir": "test",
    "noEmit": true
  }
}
